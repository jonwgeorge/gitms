# Make a hash with: npx gitms hash
GITMS_ADMIN_PASSWORD_HASH=
# Make one with: npx gitms secret
GITMS_ADMIN_SESSION_SECRET=

# Local `next dev` saves to the files in content/ (no commits). In production
# saves are commits to GitHub through a fine-grained token with
# "Contents: read and write" on this one repository.
# GITMS_ADMIN_STORE=github
# GITMS_GITHUB_TOKEN=
# GITMS_GITHUB_REPO=owner/name
# GITMS_GITHUB_BRANCH=main
