{
  "name": "gitms",
  "version": "0.0.0",
  "description": "A small Git-backed CMS for Next.js: content in your repo, every save a commit.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonwgeorge/gitms.git",
    "directory": "packages/gitms"
  },
  "keywords": [
    "cms",
    "nextjs",
    "git",
    "github",
    "markdown",
    "headless"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "gitms": "./bin/gitms.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin/index.ts",
    "./admin/ui": "./src/admin/ui.ts",
    "./server": "./src/server.ts",
    "./content": "./src/content.ts",
    "./markdown": "./src/core/markdown.ts",
    "./Markdown": "./src/admin/Markdown.tsx",
    "./proxy": "./src/next/proxy.ts",
    "./next-config": "./src/next/next-config.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
